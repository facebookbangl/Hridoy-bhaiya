rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Store settings and accounts: Public Read, Write only authenticated admin
    match /settings/{document} {
      allow read: if true;
      allow write: if request.auth != null;
    }
    
    match /accounts/{account} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Orders: Anyone can create a pending order, only Admin can view & edit
    match /orders/{orderId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }

    // Reviews: Anyone can submit, public can only read approved reviews
    match /reviews/{reviewId} {
      allow read: if resource.data.approved == true || request.auth != null;
      allow create: if true;
      allow update, delete: if request.auth != null;
    }
  }
}
